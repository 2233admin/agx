# Bind the relay on the AGX LAN interface.
AGX_RELAY_LISTEN_ADDR=0.0.0.0:15724

# Windows Go bridge or another OpenAI-compatible upstream.
AGX_RELAY_UPSTREAM_URL=http://192.168.50.10:15724

# Required for LAN clients in production. Do not commit a real token.
AGX_RELAY_TOKEN=replace-with-a-long-random-token

# Optional if the upstream itself requires bearer authentication.
# AGX_RELAY_UPSTREAM_TOKEN=
