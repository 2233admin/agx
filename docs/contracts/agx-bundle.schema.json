{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/2233admin/agx/blob/main/docs/contracts/agx-bundle.schema.json",
  "title": "AGX Bundle v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "mode",
    "provenance",
    "development_override",
    "compatibility",
    "sources",
    "templates"
  ],
  "properties": {
    "schema_version": {"const": "agx.bundle/v2"},
    "bundle_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "mode": {"enum": ["production", "development"]},
    "provenance": {"enum": ["github_release", "synthetic_test_only"]},
    "development_override": {"type": "boolean"},
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agx"],
      "properties": {
        "agx": {"type": "string", "minLength": 1}
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_plugins"],
      "properties": {
        "agent_plugins": {"$ref": "#/$defs/agentPluginsArtifact"}
      }
    },
    "templates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "content_sha256", "references"],
      "properties": {
        "version": {
          "const": "bootstrap-20260819.1"
        },
        "content_sha256": {
          "const": "6e5eee0139001ed29fdf7c3689881fd5af544d86e1a99ed67e88274921555d65"
        },
        "references": {
          "type": "object",
          "additionalProperties": false,
          "required": ["agent_plugins", "agent_control", "agent_contracts"],
          "properties": {
            "agent_plugins": {
              "$ref": "#/$defs/reference",
              "properties": {
                "repository": {"const": "zaurakworks/agent-plugins"},
                "commit_sha": {"const": "ad07742ade0f0039ed1df1a9262e8f087117fca0"}
              }
            },
            "agent_control": {
              "$ref": "#/$defs/reference",
              "properties": {
                "repository": {"const": "zaurakworks/agent-system"},
                "commit_sha": {"const": "b0e6e0e8244ef518f671e2326745cd67c6d2307a"}
              }
            },
            "agent_contracts": {
              "$ref": "#/$defs/reference",
              "properties": {
                "repository": {"const": "zaurakworks/agent-contracts"},
                "commit_sha": {"const": "5bb8ea0b54f063b0758c294b73ea270ba69322d2"}
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "production"}}},
      "then": {
        "properties": {
          "provenance": {"const": "github_release"},
          "development_override": {"const": false},
          "sources": {
            "properties": {
              "agent_plugins": {
                "properties": {
                  "download_url": {
                    "pattern": "^https://github\\.com/2233admin/agent-plugins/releases/download/[^/]+/[^/]+\\.tar\\.gz$"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"mode": {"const": "development"}}},
      "then": {
        "properties": {
          "provenance": {"const": "synthetic_test_only"},
          "development_override": {"const": true}
        }
      }
    }
  ],
  "$defs": {
    "agentPluginsArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upstream_repository",
        "distribution_repository",
        "release_tag",
        "commit_sha",
        "asset_name",
        "download_url",
        "asset_sha256",
        "content_sha256"
      ],
      "properties": {
        "upstream_repository": {"const": "zaurakworks/agent-plugins"},
        "distribution_repository": {"const": "2233admin/agent-plugins"},
        "release_tag": {"type": "string", "minLength": 1},
        "commit_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "asset_name": {"type": "string", "minLength": 1},
        "download_url": {"type": "string", "format": "uri"},
        "asset_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit_sha"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "commit_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
      }
    }
  }
}
